# Пароль администратора (создаётся при первом запуске, если учёток ещё нет).
# В production задайте обязательно — иначе будет слабый "admin" (с предупреждением в логах).
# (TEACHER_PASSWORD поддерживается как устаревший алиас.)
ADMIN_PASSWORD=admin

# Секрет для подписи cookie (сессия преподавателя / активная группа / pending).
# В production ОБЯЗАТЕЛЕН: случайная строка >=32 символов, иначе приложение не стартует.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=замените-на-случайную-строку-не-менее-32-символов

# Порт и хост HTTP-сервера (SvelteKit adapter-node)
PORT=3000
HOST=0.0.0.0

NODE_ENV=development

# Публичный адрес за reverse-proxy с HTTPS — нужен adapter-node для корректной
# проверки Origin (защита от CSRF). Пример: ORIGIN=https://exam.example.com
# ORIGIN=

# Флаг Secure для cookie. true ТОЛЬКО при раздаче через HTTPS (reverse-proxy с TLS).
COOKIE_SECURE=false

# SQLite journal mode. WAL быстрее и не блокирует чтение при записи —
# в Docker (named volume exam-data) включён по умолчанию. DELETE работает везде,
# в т.ч. на bind-mount Windows/WSL2, где WAL ломается; для локальной разработки
# на Windows оставьте DELETE.
SQLITE_JOURNAL=DELETE
